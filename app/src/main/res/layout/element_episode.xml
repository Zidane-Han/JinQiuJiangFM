<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="148dp" android:paddingTop="16dp" android:paddingBottom="16dp"
    android:background="?attr/colorSurface">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/episode_cover" android:layout_width="76dp" android:layout_height="76dp"
        android:scaleType="centerCrop" android:src="@drawable/podcast_cover"
        app:shapeAppearanceOverlay="@style/EpisodeCoverShape"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/episode_date" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toEndOf="@id/episode_cover" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/episode_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:textSize="18sp" android:lineSpacingExtra="3dp"
        android:maxLines="3" android:ellipsize="end" android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="@id/episode_date" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/episode_date" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/episode_duration" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" android:textSize="14sp" android:maxLines="2"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="@id/episode_date" app:layout_constraintEnd_toStartOf="@id/episode_download_button"
        app:layout_constraintTop_toTopOf="@id/episode_play_button" app:layout_constraintBottom_toBottomOf="@id/episode_play_button" />

    <ImageButton android:id="@+id/episode_download_button" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="10dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/descr_card_small_download_button"
        app:srcCompat="@drawable/ic_cloud_download_24dp" app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/episode_delete_button"
        app:layout_constraintTop_toTopOf="@id/episode_play_button" />

    <ImageButton android:id="@+id/episode_delete_button" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/descr_card_delete_episode_button"
        app:srcCompat="@drawable/ic_delete_24dp" app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/episode_play_button"
        app:layout_constraintTop_toTopOf="@id/episode_play_button" />

    <ProgressBar android:id="@+id/episode_playback_progress" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/circular_progressbar_background" android:contentDescription="@string/descr_card_playback_indicator"
        android:indeterminateOnly="false" android:max="12" android:progress="12"
        android:progressDrawable="@drawable/circular_progressbar" android:rotation="270" android:scaleY="-1"
        app:layout_constraintTop_toTopOf="@id/episode_play_button" app:layout_constraintBottom_toBottomOf="@id/episode_play_button"
        app:layout_constraintStart_toStartOf="@id/episode_play_button" app:layout_constraintEnd_toEndOf="@id/episode_play_button" />

    <ImageButton android:id="@+id/episode_play_button" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginTop="8dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/descr_card_small_playback_button"
        app:srcCompat="@drawable/ic_play_symbol_24dp" app:tint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/episode_title" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Group android:id="@+id/episode_playback_views"
        android:layout_width="0dp" android:layout_height="0dp"
        app:constraint_referenced_ids="episode_play_button,episode_playback_progress" />
</androidx.constraintlayout.widget.ConstraintLayout>
