<?xml version="1.0" encoding="utf-8"?>
<!-- Insets are relative to the actual launcher bounds, not fixed dp dimensions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launcher_background" />
    <item>
        <inset android:insetLeft="14%" android:insetTop="14%" android:insetRight="14%" android:insetBottom="14%">
            <bitmap android:src="@drawable/launcher_logo" android:gravity="fill" android:filter="true" />
        </inset>
    </item>
</layer-list>
